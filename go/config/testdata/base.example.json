{
  "app": {
    "name": "example api"
  },
  "log": {
    "level": "info",
    "format": "json"
  },
  "server": {
    "http": {
      "enabled": true,
      "addr": ":8080"
    },
    "grpc": {
      "enabled": true,
      "addr": ":9090"
    },
    "websocket": {
      "enabled": false,
      "addr": ""
    }
  },
  "database": {
    "host": "localhost",
    "port": 5432,
    "user": "app",
    "name": "app",
    "sslmode": "disable"
  },
  "nats": {
    "url": "nats://localhost:4222"
  },
  "migrations": {
    "path": "db/migrations"
  },
  "accounts": {
    "enabled": false,
    "config_path": "config/accounts.yaml",
    "schema": "",
    "tenancy": {
      "enabled": false,
      "default_tenant_id": ""
    },
    "access_token_ttl": 0,
    "frontend_url": "https://app.example.com",
    "api_public_url": "https://api.example.com",
    "verification_token_ttl": 0,
    "password_reset_token_ttl": 0,
    "registration_enabled": true,
    "register_as_admin": false,
    "skip_email_verification": false,
    "oauth": {
      "enabled": false,
      "state_cookie_name": "",
      "google": {
        "enabled": false,
        "client_id": "",
        "redirect_url": ""
      },
      "facebook": {
        "enabled": false
      },
      "apple": {
        "enabled": false
      }
    }
  },
  "tenants": {
    "enabled": false,
    "config_path": "config/tenants.yaml"
  },
  "currency": {
    "enabled": false,
    "schema": "currency",
    "base_currency": "USD",
    "currencies": [
      "USD",
      "EUR"
    ],
    "skip_seed": false,
    "api_url": "https://api.frankfurter.dev/v1/latest",
    "update_interval": 3600000000000
  },
  "language": {
    "enabled": false,
    "schema": "language",
    "default_language": "en",
    "languages": [
      "en",
      "pt"
    ],
    "skip_seed": false
  },
  "permissions": {
    "enabled": false,
    "schema": "account",
    "accounts_schema": "",
    "default_profile": "member",
    "skip_seed": false,
    "groups": null,
    "categories": null,
    "permissions": null,
    "profiles": null,
    "profile_permissions": null
  },
  "menu": {
    "enabled": false,
    "sidebar": {
      "floating": false,
      "hide_when_selected": false,
      "locked": false,
      "default_menu": ""
    },
    "menus": null
  },
  "ai": {
    "enabled": false,
    "providers": null,
    "routes": null
  },
  "email": {
    "from": "noreply@example.com",
    "brand": "Example",
    "smtp": {
      "host": "",
      "port": 0,
      "username": ""
    }
  },
  "mail_provisioning": {
    "enabled": false,
    "jmap_url": "",
    "domain_id": "",
    "mail_domain": ""
  }
}
